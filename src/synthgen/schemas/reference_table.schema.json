{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reference-table-0.1.0",
  "title": "Versioned reference table (R-35 format)",
  "type": "object",
  "required": [
    "table_id",
    "table_version",
    "verified",
    "source",
    "source_note",
    "entries"
  ],
  "properties": {
    "table_id": {
      "type": "string"
    },
    "table_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "verified": {
      "type": "boolean"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_note": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1
    }
  }
}